{
  "expo": {
    "name": "DailyHub AI",
    "slug": "frontend",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "dailyhubai",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dailyutility.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Scan QR codes and capture photos for notes",
        "NSMicrophoneUsageDescription": "Record voice notes",
        "NSPhotoLibraryUsageDescription": "Attach photos and videos to notes",
        "NSPhotoLibraryAddUsageDescription": "Save generated images and PDFs to your library",
        "NSFaceIDUsageDescription": "Unlock the app securely with Face ID"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#111412"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.dailyutility.app",
      "versionCode": 4,
      "googleServicesFile": "./google-services.json",
      "intentFilters": [
        {
          "action": "VIEW",
          "category": [
            "DEFAULT",
            "BROWSABLE"
          ],
          "data": [
            {
              "scheme": "content",
              "mimeType": "application/pdf"
            },
            {
              "scheme": "file",
              "mimeType": "application/pdf"
            },
            {
              "scheme": "content",
              "mimeType": "application/vnd.openxmlformats-officedocument.wordprocessingml.document"
            },
            {
              "scheme": "file",
              "mimeType": "application/vnd.openxmlformats-officedocument.wordprocessingml.document"
            },
            {
              "scheme": "content",
              "mimeType": "application/msword"
            },
            {
              "scheme": "file",
              "mimeType": "application/msword"
            }
          ]
        },
        {
          "action": "VIEW",
          "category": [
            "DEFAULT",
            "BROWSABLE"
          ],
          "data": [
            { "scheme": "content", "host": "*", "pathPattern": ".*\\.pdf" },
            { "scheme": "content", "host": "*", "pathPattern": ".*\\.docx" },
            { "scheme": "content", "host": "*", "pathPattern": ".*\\.doc" },
            { "scheme": "file", "host": "*", "pathPattern": ".*\\.pdf" },
            { "scheme": "file", "host": "*", "pathPattern": ".*\\.docx" },
            { "scheme": "file", "host": "*", "pathPattern": ".*\\.doc" }
          ]
        },
        {
          "action": "SEND",
          "category": [
            "DEFAULT"
          ],
          "data": [
            { "mimeType": "application/pdf" },
            { "mimeType": "application/vnd.openxmlformats-officedocument.wordprocessingml.document" },
            { "mimeType": "application/msword" },
            { "mimeType": "image/*" }
          ]
        },
        {
          "action": "SEND_MULTIPLE",
          "category": [
            "DEFAULT"
          ],
          "data": [
            { "mimeType": "application/pdf" },
            { "mimeType": "application/vnd.openxmlformats-officedocument.wordprocessingml.document" },
            { "mimeType": "application/msword" },
            { "mimeType": "image/*" }
          ]
        }
      ],
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.VIBRATE",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.USE_EXACT_ALARM",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#111412"
        }
      ],
      "expo-web-browser",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Unlock the app securely with Face ID"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Scan QR codes and documents"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Record voice notes"
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#5EBA8B"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "buildToolsVersion": "36.0.0",
            "minSdkVersion": 24,
            "enableProguardInReleaseBuilds": false
          }
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-3940256099942544~3347511713",
          "delayAppMeasurementInit": true
        }
      ],
      "@react-native-firebase/app",
      "@react-native-firebase/auth",
      "@react-native-google-signin/google-signin",
      "./plugins/withCodegenCMakeFix.js",
      "./plugins/withFastGradleProperties.js",
      "react-native-blob-util"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
