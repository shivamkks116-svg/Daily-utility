{
  "expo": {
    "name": "DailyHub AI",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "dailyhubai",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dailyutility.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Scan QR codes and barcodes",
        "NSMicrophoneUsageDescription": "Record voice notes",
        "NSPhotoLibraryUsageDescription": "Attach images to notes and PDFs"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#111412"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.dailyutility.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.VIBRATE",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.USE_EXACT_ALARM"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#111412"
        }
      ],
      "expo-web-browser",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Scan QR codes and documents"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Record voice notes"
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#5EBA8B"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
