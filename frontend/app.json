{
  "expo": {
    "name": "DailyHub AI",
    "slug": "frontend",
    "version": "1.0.5",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "dailyhubai",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dailyutility.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Scan QR codes and capture photos for notes",
        "NSMicrophoneUsageDescription": "Record voice notes",
        "NSPhotoLibraryUsageDescription": "Attach photos and videos to notes",
        "NSPhotoLibraryAddUsageDescription": "Save generated images and PDFs to your library",
        "NSFaceIDUsageDescription": "Unlock the app securely with Face ID"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#111412"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.dailyutility.app",
      "versionCode": 9,
      "googleServicesFile": "./google-services.json",
      "intentFilters": [
        {
          "action": "VIEW",
          "category": [
            "DEFAULT",
            "BROWSABLE"
          ],
          "data": [
            {
              "scheme": "content",
              "mimeType": "application/pdf"
            },
            {
              "scheme": "file",
              "mimeType": "application/pdf"
            },
            {
              "scheme": "content",
              "mimeType": "application/vnd.openxmlformats-officedocument.wordprocessingml.document"
            },
            {
              "scheme": "file",
              "mimeType": "application/vnd.openxmlformats-officedocument.wordprocessingml.document"
            },
            {
              "scheme": "content",
              "mimeType": "application/msword"
            },
            {
              "scheme": "file",
              "mimeType": "application/msword"
            },
            {
              "scheme": "content",
              "mimeType": "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"
            },
            {
              "scheme": "file",
              "mimeType": "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"
            },
            {
              "scheme": "content",
              "mimeType": "application/vnd.ms-excel"
            },
            {
              "scheme": "file",
              "mimeType": "application/vnd.ms-excel"
            },
            {
              "scheme": "content",
              "mimeType": "text/csv"
            },
            {
              "scheme": "file",
              "mimeType": "text/csv"
            },
            {
              "scheme": "content",
              "mimeType": "text/comma-separated-values"
            },
            {
              "scheme": "file",
              "mimeType": "text/comma-separated-values"
            }
          ]
        },
        {
          "action": "VIEW",
          "category": [
            "DEFAULT",
            "BROWSABLE"
          ],
          "data": [
            {
              "scheme": "content",
              "host": "*",
              "pathPattern": ".*\\.pdf"
            },
            {
              "scheme": "content",
              "host": "*",
              "pathPattern": ".*\\.docx"
            },
            {
              "scheme": "content",
              "host": "*",
              "pathPattern": ".*\\.doc"
            },
            {
              "scheme": "file",
              "host": "*",
              "pathPattern": ".*\\.pdf"
            },
            {
              "scheme": "file",
              "host": "*",
              "pathPattern": ".*\\.docx"
            },
            {
              "scheme": "file",
              "host": "*",
              "pathPattern": ".*\\.doc"
            },
            {
              "scheme": "content",
              "host": "*",
              "pathPattern": ".*\\.xlsx"
            },
            {
              "scheme": "content",
              "host": "*",
              "pathPattern": ".*\\.xls"
            },
            {
              "scheme": "content",
              "host": "*",
              "pathPattern": ".*\\.csv"
            },
            {
              "scheme": "file",
              "host": "*",
              "pathPattern": ".*\\.xlsx"
            },
            {
              "scheme": "file",
              "host": "*",
              "pathPattern": ".*\\.xls"
            },
            {
              "scheme": "file",
              "host": "*",
              "pathPattern": ".*\\.csv"
            }
          ]
        },
        {
          "action": "SEND",
          "category": [
            "DEFAULT"
          ],
          "data": [
            {
              "mimeType": "application/pdf"
            },
            {
              "mimeType": "application/vnd.openxmlformats-officedocument.wordprocessingml.document"
            },
            {
              "mimeType": "application/msword"
            },
            {
              "mimeType": "image/*"
            },
            {
              "mimeType": "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"
            },
            {
              "mimeType": "application/vnd.ms-excel"
            },
            {
              "mimeType": "text/csv"
            },
            {
              "mimeType": "text/comma-separated-values"
            }
          ]
        },
        {
          "action": "SEND_MULTIPLE",
          "category": [
            "DEFAULT"
          ],
          "data": [
            {
              "mimeType": "application/pdf"
            },
            {
              "mimeType": "application/vnd.openxmlformats-officedocument.wordprocessingml.document"
            },
            {
              "mimeType": "application/msword"
            },
            {
              "mimeType": "image/*"
            }
          ]
        }
      ],
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.VIBRATE",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.USE_EXACT_ALARM",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#111412"
        }
      ],
      "expo-web-browser",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Unlock the app securely with Face ID"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Scan QR codes and documents"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Record voice notes"
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#5EBA8B"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "buildToolsVersion": "36.0.0",
            "minSdkVersion": 24,
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "extraProguardRules": "-keep class com.facebook.react.** { *; }\n-keep class com.facebook.hermes.** { *; }\n-keep class com.facebook.jni.** { *; }\n-keep class com.facebook.** { *; }\n-keep class expo.modules.** { *; }\n-keep class org.wonday.pdf.** { *; }\n-keep class io.legere.** { *; }\n-keep class com.github.barteksc.** { *; }\n-keep class com.shockwave.** { *; }\n-keep class com.reactnativeandroidwidget.** { *; }\n-keep class io.invertase.** { *; }\n-keep class com.google.android.gms.ads.** { *; }\n-keep class com.revenuecat.** { *; }\n-keep class com.swmansion.** { *; }\n-keep class com.th3rdwave.safeareacontext.** { *; }\n-keep class com.horcrux.svg.** { *; }\n-keep class fr.greweb.reactnativeviewshot.** { *; }\n-keep class com.dailyutility.app.** { *; }\n-keep class com.google.android.play.core.integrity.** { *; }\n-dontwarn com.google.android.play.core.**\n-dontwarn org.bouncycastle.**\n-dontwarn org.conscrypt.**\n-dontwarn org.openjsse.**"
          }
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-3735972538807236~5699981361",
          "delayAppMeasurementInit": true
        }
      ],
      "@react-native-firebase/app",
      "@react-native-firebase/auth",
      "@react-native-google-signin/google-signin",
      "./plugins/withCodegenCMakeFix.js",
      "./plugins/withFastGradleProperties.js",
      "./plugins/withSystemPhotoPicker.js",
      "react-native-blob-util",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "DailyHubQuickActions",
              "label": "DailyHub Quick Actions",
              "description": "One-tap access to PDF scan, AI chat, notes & QR scanner.",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 1,
              "resizeMode": "horizontal|vertical",
              "widgetFeatures": "reconfigurable",
              "updatePeriodMillis": 1800000,
              "previewImage": "./assets/images/widget-preview-quick.png"
            },
            {
              "name": "DailyHubRecents",
              "label": "DailyHub Recent Files",
              "description": "Jump back into your latest PDFs and scans.",
              "minWidth": "250dp",
              "minHeight": "180dp",
              "targetCellWidth": 4,
              "targetCellHeight": 3,
              "resizeMode": "horizontal|vertical",
              "widgetFeatures": "reconfigurable",
              "updatePeriodMillis": 1800000,
              "previewImage": "./assets/images/widget-preview-recents.png"
            }
          ]
        }
      ],
      [
        "react-native-fbsdk-next",
        {
          "appID": "2359996044826832",
          "clientToken": "6dde80c46c8d4c510bfd7a4a119e3c0e",
          "displayName": "DailyHub AI",
          "scheme": "fb2359996044826832",
          "autoLogAppEventsEnabled": true,
          "isAutoInitEnabled": true,
          "advertiserIDCollectionEnabled": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}